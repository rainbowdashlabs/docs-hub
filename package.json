{
  "name": "docs-hub",
  "version": "1.0.1",
  "description": "Docusaurus hub that gathers the docs folders of many repositories into one site with a separate space per project.",
  "license": "LGPL-3.0-or-later",
  "repository": "github:rainbowdashlabs/docs-hub",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "docs-hub": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/theme/hub.css', 'dist/theme/hub.css')\"",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "example:start": "node dist/cli.js start example",
    "example:build": "node dist/cli.js build example"
  },
  "dependencies": {
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@fontsource/noto-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jiti": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "satori": "^0.63.2"
  },
  "peerDependencies": {
    "@docusaurus/core": "3.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "core-js": false,
    "@swc/core": false
  }
}
